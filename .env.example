# Шаблон настроек бота обмена. Настоящие значения — только в Railway → Variables (или в .env, который не попадает в GitHub).

TELEGRAM_BOT_TOKEN=            # токен бота от @BotFather
MANAGER_CHAT_ID=               # чат, куда приходят заявки (/partners, /backup работают только там)
GOOGLE_SHEET_ID=               # ID таблицы (кусок ссылки между /d/ и /edit)
GOOGLE_SERVICE_ACCOUNT_JSON=   # JSON-ключ сервисного аккаунта Google целиком, в одну строку

# Названия листов (если отличаются от стандартных)
GOOGLE_WORKSHEET_NAME=Курсы                 # курсы для клиентов партнёров / общие
GOOGLE_OWN_WORKSHEET_NAME=Мои курсы         # курсы для ваших прямых клиентов (если листа нет — берутся «Курсы»)
GOOGLE_ORDERS_WORKSHEET_NAME=Заявки
GOOGLE_PARTNERS_WORKSHEET_NAME=Партнёры
GOOGLE_CLIENTS_WORKSHEET_NAME=Клиенты партнёров
